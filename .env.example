# Token da conta de usuário (selfbot) — obrigatório
DISCORD_TOKEN=seu_token_de_usuario_aqui

# Token do bot (opcional) — rota /userProfile básica
DISCORD_BOT_TOKEN=seu_token_de_bot_aqui

# ID do servidor padrão para buscar perfil e boost
GUILD_ID=1234567890123456789

# Render define PORT automaticamente — local use 3000
PORT=3000

# Emojis customizados do seu servidor (opcional)
# BOOST_EMOJI_1=<:boost1:123456789>
# BOOST_EMOJI_9=<:boost9:123456789>
