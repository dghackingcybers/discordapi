# Token da conta de usuário (selfbot) — obrigatório
DISCORD_TOKEN=seu_token_de_usuario_aqui

# Token do bot (comando /userinfo)
DISCORD_BOT_TOKEN=seu_token_de_bot_aqui
CLIENT_ID=id_do_bot_no_discord_developer_portal

# ID do servidor padrão
GUILD_ID=1234567890123456789

# ID do canal #saveicon (backup permanente dos ícones — usa DISCORD_BOT_TOKEN)
ARCHIVE_CHANNEL_ID=1234567890123456789

# URL da API (Render ou local)
API_URL=https://discordapi-jzd1.onrender.com
PORT=3000

# ============================================================
# EMOJIS CUSTOMIZADOS DO SEU SERVIDOR (ex: RZ | Emojis 2)
# Configure aqui E no Render → Environment (mesmas variáveis)
# Formato: <:nome_do_emoji:ID>  ou  <a:nome:ID> se animado
#
# Como pegar o ID:
# 1. Discord → Configurações → Avançado → Modo desenvolvedor ✅
# 2. Configurações do servidor → Emoji → clique direito → Copiar ID
# 3. Ou digite \:nome_do_emoji: no chat e copie o formato
# ============================================================

# BOOST — 9 níveis (1 mês → 24 meses)
BOOST_EMOJI_1=<:boost_1m:COLE_ID_AQUI>
BOOST_EMOJI_2=<:boost_2m:COLE_ID_AQUI>
BOOST_EMOJI_3=<:boost_3m:COLE_ID_AQUI>
BOOST_EMOJI_4=<:boost_6m:COLE_ID_AQUI>
BOOST_EMOJI_5=<:boost_9m:COLE_ID_AQUI>
BOOST_EMOJI_6=<:boost_12m:COLE_ID_AQUI>
BOOST_EMOJI_7=<:boost_15m:COLE_ID_AQUI>
BOOST_EMOJI_8=<:boost_18m:COLE_ID_AQUI>
BOOST_EMOJI_9=<:boost_24m:COLE_ID_AQUI>

# NITRO — 8 níveis (1 mês → 72 meses)
NITRO_EMOJI_1=<:nitro_1m:COLE_ID_AQUI>
NITRO_EMOJI_2=<:nitro_3m:COLE_ID_AQUI>
NITRO_EMOJI_3=<:nitro_6m:COLE_ID_AQUI>
NITRO_EMOJI_4=<:nitro_12m:COLE_ID_AQUI>
NITRO_EMOJI_5=<:nitro_24m:COLE_ID_AQUI>
NITRO_EMOJI_6=<:nitro_36m:COLE_ID_AQUI>
NITRO_EMOJI_7=<:nitro_60m:COLE_ID_AQUI>
NITRO_EMOJI_8=<:nitro_72m:COLE_ID_AQUI>

# Insígnias extras do perfil (Quest, Active Dev, etc.)
BADGE_EMOJI_QUEST=<:Badge_Completed_a_Quest:1541392759532036179>
BADGE_EMOJI_EARLY_SUPPORTER=<:EarlySupporter:1067078594863562803>
BADGE_EMOJI_ACTIVE_DEV=<:seu_emoji_active_dev:ID>
BADGE_EMOJI_HYPESQUAD_1=<:hypesquad_bravery:ID>
BADGE_EMOJI_HYPESQUAD_2=<:hypesquad_brilliance:ID>
BADGE_EMOJI_HYPESQUAD_3=<:hypesquad_balance:ID>
